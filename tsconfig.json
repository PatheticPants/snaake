{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@shared/*": ["./shared/src/*"]
    }
  },
  "include": ["shared/src/**/*", "server/src/**/*", "client/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
